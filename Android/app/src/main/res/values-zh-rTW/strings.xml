    <string name="app_subtitle">你的手機，就是一台真正的路由器</string>
    <string name="unknown">未知</string>
    <string name="close">關閉</string>
    <string name="back">返回</string>

    <string name="welcome_body">在手機自身的 Wi-Fi 晶片上執行的真實存取點，由 hostapd 與 dnsmasq 驅動。與 Linux 路由器執行的是同一套軟體，只是跑在手機自己的核心上。</string>
    <string name="get_started">開始使用</string>
    <string name="next">下一步</string>
    <string name="page_counter">第 %1$d 頁，共 %2$d 頁</string>
    <string name="feat_upstream_title">分享任何網路連線</string>
    <string name="feat_upstream_desc">行動數據、Wi-Fi 或 VPN。你的裝置透過所選的上游連線，也可以跟隨手機目前使用的網路。</string>
    <string name="feat_openwrt_title">以 OpenWrt 擔任路由器</string>
    <string name="feat_openwrt_desc">把熱點交給 Droidspaces 中的 OpenWrt 容器管理。防火牆區域、連接埠轉送、單一裝置限流與 LuCI，全都在手機上完成。</string>
    <string name="feat_radio_title">調整無線電參數</string>
    <string name="feat_radio_desc">2.4 或 5 GHz、通道與頻寬、WPA2 或 WPA3、隱藏網路名稱與固定閘道，已儲存的位址始終可用。</string>

