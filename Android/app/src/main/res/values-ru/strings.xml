    <string name="container_label">Контейнер</string>
    <string name="container_upstream_desc">Этот контейнер Droidspaces управляет DHCP, DNS и NAT для точки доступа.</string>
    <string name="interface_upstream_desc">VirtualAP управляет DHCP, DNS и NAT через этот интерфейс.</string>

